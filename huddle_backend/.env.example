# FastAPI / ConnectHuddle backend configuration

# CORS: comma-separated origins (e.g. http://localhost:3000,https://yourdomain.com)
CORS_ORIGINS=*

# JWT settings
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# PostgreSQL connection
# Prefer a full DSN like:
# postgresql://user:password@host:port/dbname
POSTGRES_DSN=

# Optional: override WebSocket ping intervals/timeouts (seconds)
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
